@page
@model fyserver.Pages.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "登录";
}
<!DOCTYPE html>
<html lang="zh-Hans">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>登录 · fyserver 后台</title>
    <link rel="stylesheet" href="/admin-assets/admin.css" />
    <style>
        .login-wrap {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 20px;
        }

        .login-card {
            width: 100%;
            max-width: 430px;
            background: #fff;
            border: 1px solid var(--md-outline);
            border-radius: 16px;
            box-shadow: var(--md-elevation-2);
            padding: 28px 26px;
        }

        .login-card h1 {
            margin: 0 0 4px;
            font-size: 20px;
            font-weight: 500;
        }

        .login-card code {
            background: var(--md-surface-variant);
            border-radius: 4px;
            padding: 1px 5px;
        }
    </style>
</head>
<body>
<div class="login-wrap">
    <div class="login-card">
        <h1>fyserver 后台</h1>
        <p class="muted">使用 <span class="mono">setting.json</span> 中的 <span class="mono">adminApiKey</span> 登录。</p>

        @if (TempData["Message"] is string ok)
        {
            <div class="banner banner--ok">@ok</div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="banner banner--err">@err</div>
        }

        @if (Model.CanLogin)
        {
            <form method="post">
                <div class="field">
                    <label for="Key">管理密钥</label>
                    <input type="password" id="Key" name="Key" autocomplete="current-password" autofocus />
                </div>
                <button type="submit" class="btn" style="width:100%">登录</button>
            </form>
        }
        else if (Model.IsLoopback)
        {
            <div class="banner banner--ok">
                服务器未配置 <span class="mono">adminApiKey</span>，当前为「仅本机可访问」模式，无需登录。
            </div>
            <a class="btn" href="/admin/index" style="width:100%;text-align:center">进入后台</a>
        }
        else
        {
            <div class="banner banner--err">
                服务器未配置 <span class="mono">adminApiKey</span>，后台仅允许本机（loopback）访问，远程无法登录。
            </div>
            <p class="muted">
                如需远程管理，请在服务端 <span class="mono">setting.json</span> 中填写
                <span class="mono">adminApiKey</span> 后重启服务，再回到本页用该密钥登录；
                也可以用 <span class="mono">X-Admin-Key</span> 请求头直接调用 <span class="mono">/admin/*</span> API。
            </p>
            <a class="btn btn--outline" href="/admin/login" style="width:100%;text-align:center">重新检查</a>
        }

        <p class="muted" style="margin-bottom:0">
            <a href="/admin/index">返回后台首页</a>
        </p>
    </div>
</div>
</body>
</html>
