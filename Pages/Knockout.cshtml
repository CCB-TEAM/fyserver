@page
@model fyserver.Pages.KnockoutModel
@{
    ViewData["Title"] = "Knockout";
    ViewData["Active"] = "knockout";
    ViewData["BasePath"] = "/admin/knockout";
    ViewData["EmptyText"] = "还没有 knockout 条目";
    var entries = Model.Entries;
}

<div class="page-head">
    <h1>Knockout（淘汰赛）</h1>
    <p>数据文件 <span class="mono">@Model.ConfigPath</span>；保存前校验 JSON 并备份为 <span class="mono">.bak</span>。</p>
</div>

@if (Model.ShowList)
{
    <div class="btn-row" style="margin-bottom:16px">
        <a class="btn" href="/admin/knockout?new=1">新建 Knockout</a>
        <span class="muted">共 @entries.Count 条</span>
    </div>

    <div class="card">
        @await Html.PartialAsync("_ContentEntryList", entries)
    </div>
}
else
{
    <div class="btn-row" style="margin-bottom:16px">
        <a class="btn btn--outline" href="/admin/knockout">← 返回列表</a>
        <span class="muted">@Model.PageTitle</span>
    </div>

    <form method="post">
        <div class="card">
            <h2>基础信息</h2>
            <div class="field">
                <label for="Name">名称（name）</label>
                <input type="text" id="Name" name="Name" value="@Model.Name" />
            </div>
            <div class="form-grid">
                <div class="field">
                    <label for="StartDate">开始时间</label>
                    <input type="text" id="StartDate" name="StartDate" value="@Model.StartDate" placeholder="2026-01-01 00:00:00" />
                </div>
                <div class="field">
                    <label for="EndDate">结束时间</label>
                    <input type="text" id="EndDate" name="EndDate" value="@Model.EndDate" placeholder="2026-12-31 23:59:00" />
                </div>
            </div>
        </div>

        <div class="card">
            <h2>报名费与被牌组规则</h2>
            <div class="form-grid">
                <div class="field">
                    <label for="Gold">金币（entry_prices.gold）</label>
                    <input type="number" id="Gold" name="Gold" value="@Model.Gold" min="0" />
                </div>
                <div class="field">
                    <label for="Diamonds">钻石（entry_prices.diamonds）</label>
                    <input type="number" id="Diamonds" name="Diamonds" value="@Model.Diamonds" min="0" />
                </div>
                <div class="field">
                    <label for="Ticket">门票（entry_prices.ticket）</label>
                    <input type="number" id="Ticket" name="Ticket" value="@Model.Ticket" min="0" />
                </div>
                <div class="field">
                    <label for="Points">积分（entry_prices.points）</label>
                    <input type="number" id="Points" name="Points" value="@Model.Points" min="0" />
                </div>
            </div>

            <div class="chip-row" style="margin-top:6px">
                <label class="check-chip" for="AllowReserved">
                    <input type="checkbox" id="AllowReserved" name="AllowReserved" value="true" checked="@Model.AllowReserved" />
                    <span>允许预备卡（allow_reserved）</span>
                </label>
                <label class="check-chip" for="AllowMoreAllyCards">
                    <input type="checkbox" id="AllowMoreAllyCards" name="AllowMoreAllyCards" value="true" checked="@Model.AllowMoreAllyCards" />
                    <span>允许更多盟国卡（allow_more_ally_cards）</span>
                </label>
                <label class="check-chip" for="AllowUnowned">
                    <input type="checkbox" id="AllowUnowned" name="AllowUnowned" value="true" checked="@Model.AllowUnowned" />
                    <span>允许未拥有卡（allow_unowned）</span>
                </label>
            </div>
        </div>

        <div class="card">
            <h2>回合计时（turn_timers）</h2>
            <div class="form-grid">
                <div class="field">
                    <label for="TurnLength">回合时长（秒）</label>
                    <input type="number" id="TurnLength" name="TurnLength" value="@Model.TurnLength" min="0" />
                </div>
                <div class="field">
                    <label for="LengthAfterTimeout">超时后时长（秒）</label>
                    <input type="number" id="LengthAfterTimeout" name="LengthAfterTimeout" value="@Model.LengthAfterTimeout" min="0" />
                </div>
            </div>
        </div>

        <div class="card">
            <h2>奖励阶梯（rewards）</h2>
            <p class="muted">JSON 数组，按名次顺序排列；<span class="mono">rewards.0</span> 为冠军档。</p>
            <textarea id="RewardsJson" name="RewardsJson" class="rules-textarea" spellcheck="false">@Model.RewardsJson</textarea>
        </div>

        <div class="card">
            <h2>多语言文本（texts）</h2>
            <p class="muted">留空的字段不会写入 JSON；已有内容不会被空值覆盖。</p>
            <div class="table-wrap">
                <table class="md-table">
                    <thead>
                    <tr>
                        <th>语言</th>
                        <th>标题</th>
                        <th>副标题</th>
                        <th>短描述</th>
                        <th>长描述</th>
                    </tr>
                    </thead>
                    <tbody>
                    @for (var i = 0; i < Model.Texts.Count; i++)
                    {
                        <tr>
                            <td class="mono">
                                @Model.Texts[i].Language
                                <input type="hidden" name="Texts[@i].Language" value="@Model.Texts[i].Language" />
                            </td>
                            <td><input type="text" name="Texts[@i].Title" value="@Model.Texts[i].Title" /></td>
                            <td><input type="text" name="Texts[@i].Subtitle" value="@Model.Texts[i].Subtitle" /></td>
                            <td><input type="text" name="Texts[@i].ShortDescription" value="@Model.Texts[i].ShortDescription" /></td>
                            <td><input type="text" name="Texts[@i].LongDescription" value="@Model.Texts[i].LongDescription" /></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card">
            <h2>完整条目 JSON</h2>
            <p class="muted">上面未覆盖的字段（<span class="mono">visibility_date</span>、<span class="mono">active_period</span>、<span class="mono">skirmish_rules</span>、<span class="mono">deck_rules.blacklist</span>）在这里维护。</p>
            <textarea id="EntryJson" name="EntryJson" class="json-textarea" spellcheck="false">@Model.EntryJson</textarea>
        </div>

        <div class="btn-row">
            <button type="submit" class="btn" data-confirm="确认保存这个 knockout 配置？原文件会备份为 .bak。">保存</button>
            <a class="btn btn--outline" href="/admin/knockout">取消</a>
        </div>
    </form>
}
