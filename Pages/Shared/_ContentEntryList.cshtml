@model IReadOnlyList<fyserver.Services.ContentEntriesService.Entry>
@{
    var basePath = ViewData["BasePath"] as string ?? "/admin/skirmish";
    var emptyText = ViewData["EmptyText"] as string ?? "还没有条目";
}
<div class="table-wrap">
    <table class="md-table" data-content-entries>
        <thead>
        <tr>
            <th>ID</th>
            <th>名称</th>
            <th>开始</th>
            <th>结束</th>
            <th>操作</th>
        </tr>
        </thead>
        <tbody>
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="5" class="empty">@emptyText</td>
            </tr>
        }
        @foreach (var entry in Model.OrderBy(e => e.Id))
        {
            <tr>
                <td class="mono">@entry.Id</td>
                <td><a href="@basePath?id=@entry.Id">@entry.Name</a></td>
                <td class="mono">@entry.StartDate</td>
                <td class="mono">@entry.EndDate</td>
                <td>
                    <div class="btn-row">
                        <a class="btn btn--small btn--outline" href="@basePath?id=@entry.Id">编辑</a>
                        <form method="post" action="@(basePath)?handler=Delete&targetId=@(entry.Id)" class="inline-form">
                            <button type="submit" class="btn btn--small btn--danger"
                                    data-confirm="确认删除条目 @entry.Id（@entry.Name）？删除会立即写入配置文件，原文件备份为 .bak。">删除</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
