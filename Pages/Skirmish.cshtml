@page
@model fyserver.Pages.SkirmishModel
@{
    ViewData["Title"] = "Skirmish";
    ViewData["Active"] = "skirmish";
    ViewData["BasePath"] = "/admin/skirmish";
    ViewData["EmptyText"] = "还没有 skirmish 条目";
    var entries = Model.Entries;
}

<div class="page-head">
    <h1>Skirmish（乱斗）</h1>
    <p>数据文件 <span class="mono">@Model.ConfigPath</span>；保存前校验 JSON 并备份为 <span class="mono">.bak</span>。</p>
</div>

@if (Model.ShowList)
{
    <div class="btn-row" style="margin-bottom:16px">
        <a class="btn" href="/admin/skirmish?new=1">新建 Skirmish</a>
        <span class="muted">共 @entries.Count 条</span>
    </div>

    <div class="card">
        @await Html.PartialAsync("_ContentEntryList", entries)
    </div>
}
else
{
    <div class="btn-row" style="margin-bottom:16px">
        <a class="btn btn--outline" href="/admin/skirmish">← 返回列表</a>
        <span class="muted">@Model.PageTitle</span>
    </div>

    <form method="post">
        <div class="card">
            <h2>基础信息</h2>
            <div class="field">
                <label for="Name">名称 <span class="muted">（写入 name）</span></label>
                <input type="text" id="Name" name="Name" value="@Model.Name" />
            </div>
            <div class="form-grid">
                <div class="field">
                    <label for="StartDate">开始时间</label>
                    <input type="text" id="StartDate" name="StartDate" value="@Model.StartDate" placeholder="2026-01-01 00:00:00" />
                </div>
                <div class="field">
                    <label for="EndDate">结束时间</label>
                    <input type="text" id="EndDate" name="EndDate" value="@Model.EndDate" placeholder="2026-12-31 23:59:00" />
                </div>
            </div>
        </div>

        <div class="card">
            <h2>常用规则</h2>
            <div class="form-grid">
                <div class="field">
                    <label for="RewardType">奖励类型</label>
                    <select id="RewardType" name="RewardType">
                        @foreach (var type in new[] { "gold", "diamonds", "trophies", "core_pack", "random_pack", "officer_pack" })
                        {
                            <option value="@type" selected="@(Model.RewardType == type)">@type</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label for="RewardAmount">奖励数量</label>
                    <input type="number" id="RewardAmount" name="RewardAmount" value="@Model.RewardAmount" min="0" />
                </div>
                <div class="field">
                    <label for="TurnLength">回合时长（秒）</label>
                    <input type="number" id="TurnLength" name="TurnLength" value="@Model.TurnLength" min="0" />
                </div>
            </div>

            <div class="field">
                <label>禁卡类型（rules.blacklist）</label>
                <div class="chip-row">
                    @foreach (var type in Model.CardTypeOptions)
                    {
                        var id = $"bl_{type}";
                        <label class="check-chip" for="@id">
                            <input type="checkbox" id="@id" name="Blacklist" value="@type"
                                   checked="@(Model.Blacklist.Contains(type))" />
                            <span>@type</span>
                        </label>
                    }
                </div>
            </div>

            <div class="form-grid">
                <div class="field">
                    <label for="DescriptionZh">中文规则说明（localization.ZH-HANS.description）</label>
                    <textarea id="DescriptionZh" name="DescriptionZh" class="rules-textarea">@Model.DescriptionZh</textarea>
                </div>
                <div class="field">
                    <label for="DescriptionEn">英文规则说明（localization.EN.description）</label>
                    <textarea id="DescriptionEn" name="DescriptionEn" class="rules-textarea">@Model.DescriptionEn</textarea>
                </div>
            </div>
        </div>

        <div class="card">
            <h2>完整 rules JSON</h2>
            <p class="muted">上面未覆盖的字段（<span class="mono">max_cards_of_type</span>、<span class="mono">start_of_turn_damage</span> 等）在这里维护；保存时表单控件的值会覆盖 JSON 中对应字段。</p>
            <textarea id="RulesJson" name="RulesJson" class="json-textarea" spellcheck="false">@Model.RulesJson</textarea>
        </div>

        <div class="btn-row">
            <button type="submit" class="btn" data-confirm="确认保存这个 skirmish 配置？原文件会备份为 .bak。">保存</button>
            <a class="btn btn--outline" href="/admin/skirmish">取消</a>
        </div>
    </form>
}
