@page
@model fyserver.Pages.MatchesModel
@{
    ViewData["Title"] = "对局";
    ViewData["Active"] = "matches";
}

<div class="page-head">
    <h1>对局与匹配</h1>
    <p>进行中的真人对局 @Model.ActiveMatches.Count 条，队列等待玩家 @Model.Queues.Sum(q => q.Players.Count) 人，在线连接 @Model.OnlineCount 条。</p>
</div>

<div class="card">
    <h2>进行中的对局</h2>
    <div class="table-wrap">
        <table class="md-table">
            <thead>
            <tr>
                <th>对局 ID</th>
                <th>模式</th>
                <th>状态</th>
                <th>回合</th>
                <th>动作数</th>
                <th>左侧玩家</th>
                <th>右侧玩家</th>
                <th>操作</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.ActiveMatches.Count == 0)
            {
                <tr>
                    <td colspan="8" class="empty">当前没有进行中的对局</td>
                </tr>
            }
            @foreach (var match in Model.ActiveMatches)
            {
                <tr>
                    <td class="mono">@match.MatchId</td>
                    <td>@match.MatchType</td>
                    <td>@match.Status</td>
                    <td>@match.CurrentTurn</td>
                    <td>@match.ActionCount</td>
                    <td>
                        <span class="mono">#@match.LeftPlayerId</span> @match.LeftPlayerName
                        @if (match.LeftOnline)
                        {
                            <span class="chip chip--ok">在线</span>
                        }
                        <span class="muted">@match.LeftStatus</span>
                    </td>
                    <td>
                        <span class="mono">#@match.RightPlayerId</span> @match.RightPlayerName
                        @if (match.RightOnline)
                        {
                            <span class="chip chip--ok">在线</span>
                        }
                        <span class="muted">@match.RightStatus</span>
                    </td>
                    <td>
                        <form method="post" asp-page-handler="RemoveMatch" class="inline-form">
                            <input type="hidden" name="matchId" value="@match.MatchId" />
                            <button type="submit" class="btn btn--small btn--danger"
                                    data-confirm="确认移除对局 @match.MatchId？两侧玩家将被移出该对局。">移除</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="card">
    <h2>匹配队列</h2>
    <div class="table-wrap">
        <table class="md-table">
            <thead>
            <tr>
                <th>队列</th>
                <th>等待玩家</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Queues.Count == 0)
            {
                <tr>
                    <td colspan="2" class="empty">所有队列均为空</td>
                </tr>
            }
            @foreach (var queue in Model.Queues)
            {
                <tr>
                    <td>@queue.Name（@queue.Players.Count）</td>
                    <td>
                        @foreach (var player in queue.Players)
                        {
                            <span class="chip chip--off mono" style="margin-right:6px">#@player.PlayerId @player.Name</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <form method="post" asp-page-handler="ClearQueues" style="margin-top:14px">
        <button type="submit" class="btn btn--outline"
                data-confirm="确认清空全部匹配队列？等待中的玩家需要重新加入队列。">清空全部队列</button>
    </form>
</div>
