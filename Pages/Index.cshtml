@page
@model fyserver.Pages.IndexModel
@{
    ViewData["Title"] = "概览";
    ViewData["Active"] = "overview";
}

<div class="page-head">
    <h1>服务器概览</h1>
    <p>进程状态、端口配置与实时统计。HTTP 与 WebSocket 共用同一端口。</p>
</div>

<div class="card-grid">
    <div class="stat-card">
        <div class="stat-card__label">用户总数</div>
        <div class="stat-card__value">@Model.UserCount</div>
        <div class="stat-card__hint">其中封禁 @Model.BannedCount 人</div>
    </div>
    <div class="stat-card">
        <div class="stat-card__label">在线连接</div>
        <div class="stat-card__value">@Model.OnlineCount</div>
        <div class="stat-card__hint">WebSocket 长连接数</div>
    </div>
    <div class="stat-card">
        <div class="stat-card__label">进行中对局</div>
        <div class="stat-card__value">@Model.ActiveMatchCount</div>
        <div class="stat-card__hint">已排除人机对局</div>
    </div>
    <div class="stat-card">
        <div class="stat-card__label">匹配队列</div>
        <div class="stat-card__value">@Model.QueuedPlayerCount</div>
        <div class="stat-card__hint">等待匹配中的玩家</div>
    </div>
</div>

<div class="card">
    <h2>运行信息</h2>
    <dl class="kv">
        <dt>HTTP 监听</dt>
        <dd class="mono">@Model.HttpListenAddress</dd>
        <dt>客户端 HTTP 地址</dt>
        <dd class="mono">@Model.HttpClientAddress</dd>
        <dt>客户端 WebSocket 地址</dt>
        <dd class="mono">@Model.WebSocketAddress</dd>
        <dt>端口 / 对外 IP</dt>
        <dd class="mono">@Model.Port / @Model.Ip</dd>
        <dt>反作弊开关</dt>
        <dd>@(Model.BanCheat ? "已开启" : "已关闭")</dd>
        <dt>管理密钥</dt>
        <dd>@(Model.AdminKeyConfigured ? "已配置（远程需 X-Admin-Key 或登录）" : "未配置（仅本机可访问后台）")</dd>
        <dt>启动时间</dt>
        <dd>@Model.StartedAt（已运行 @Model.Uptime）</dd>
        <dt>运行环境</dt>
        <dd>@Model.RuntimeVersion · @Model.OsVersion</dd>
        <dt>卡组总数</dt>
        <dd>@Model.DeckCount</dd>
    </dl>
</div>

<div class="card">
    <h2>匹配队列明细</h2>
    <div class="table-wrap">
        <table class="md-table">
            <thead>
            <tr>
                <th>队列</th>
                <th>等待人数</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var queue in Model.Queues)
            {
                <tr>
                    <td>@queue.Name</td>
                    <td>@queue.Count</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="card">
    <h2>运维操作</h2>
    <div class="btn-row">
        <form method="post" asp-page-handler="ReloadStore" class="inline-form">
            <button type="submit" class="btn">重载商店配置</button>
        </form>
        <a class="btn btn--outline" href="/admin/users">用户管理</a>
        <a class="btn btn--outline" href="/admin/frontpage">编辑首页公告</a>
    </div>
    <p class="muted" style="margin-bottom:0">
        重载商店配置等价于控制台命令 <span class="mono">reloadstore</span>；控制台仍可用
        <span class="mono">savedbss</span> / <span class="mono">savedbfo</span> 保存数据。
    </p>
</div>

<div class="card">
    <h2>setting.json</h2>
    <textarea readonly>@Model.SettingJson</textarea>
</div>
